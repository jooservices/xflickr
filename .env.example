# PostgreSQL host for local development; use the generated worktree .env for the shared services.
DB_HOST=127.0.0.1
# Host PostgreSQL port for the shared stack.
DB_PORT=15435
# Non-live database for a copied example configuration. Generated worktree
# environments use DB_DATABASE/DB_USERNAME; the loader accepts both names.
DB_NAME=xflickr_test
# Local development account; the generated worktree .env supplies the shared account.
DB_USER=postgres
# Optional PostgreSQL password for local development.
DB_PASSWORD=
# Local PostgreSQL default without TLS.
DB_SSLMODE=disable
# Maximum number of PostgreSQL connections held by one process.
DB_MAX_CONNS=20
# Minimum number of warm PostgreSQL connections held by one process.
DB_MIN_CONNS=2
# Maximum connection lifetime before recycling.
DB_MAX_CONN_LIFETIME=1h
# Maximum time a connection can remain idle before recycling.
DB_MAX_CONN_IDLE_TIME=30m
# Interval between idle connection health checks.
DB_HEALTH_CHECK_PERIOD=1m

# Local host address for the shared Redis service.
REDIS_HOST=127.0.0.1
# Host port for the shared Redis service.
REDIS_PORT=16382
# Shared test Redis index; the generated worktree .env selects the ticket namespace.
REDIS_DB=8
# Optional Redis password for local development.
REDIS_PASSWORD=
# Ticket-specific namespace that prevents key collisions between worktrees.
REDIS_PREFIX=xflickr_jooxf68:

# Shared Elasticsearch endpoint used by SearchIndex; pgvector remains the fallback.
SEARCH_URL=http://127.0.0.1:19200
# Optional SearchIndex username.
SEARCH_USERNAME=
# Optional SearchIndex password.
SEARCH_PASSWORD=
# Ticket-specific index namespace; keep this unique to the worktree.
OPENSEARCH_INDEX_PREFIX=xflickr_jooxf68_

# Local storage is the safe default; use s3 only when an S3 adapter is configured.
BLOB_DRIVER=local
# Local directory for downloaded originals and thumbnails.
BLOB_LOCAL_DIR=var/blobs

# Maximum total temporary blob storage in bytes (0 disables the cap).
BLOB_MAX_BYTES=10737418240
# Maximum asset lifetime; S3 lifecycle adds one day as a safety margin.
BLOB_MAX_TTL=24h
# Optional S3-compatible endpoint; blank while using local storage.
S3_ENDPOINT=
# Default S3 region for local development.
S3_REGION=us-east-1
# Optional S3 bucket; blank while using local storage.
S3_BUCKET=
# Optional S3 access key; blank while using local storage.
S3_ACCESS_KEY=
# Optional S3 secret key; blank while using local storage.
S3_SECRET_KEY=
# Disable path-style S3 URLs by default.
S3_USE_PATH_STYLE=false

# Local WSL Ollama endpoint.
OLLAMA_URL=http://127.0.0.1:11434
# Default local caption model; override with an installed model.
OLLAMA_CAPTION_MODEL=llama3.2
# Default local embedding model; override with an installed model.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Shared OpenObserve endpoint from the environment rules.
OPENOBSERVE_URL=http://127.0.0.1:15080
# Optional OpenObserve username for local development.
OPENOBSERVE_USERNAME=
# Optional OpenObserve password for local development.
OPENOBSERVE_PASSWORD=
# Default OpenObserve organization for local development.
OPENOBSERVE_ORG=default
# Default application log stream.
OPENOBSERVE_STREAM=xflickr
# File for OpenTelemetry log records that cannot be exported before shutdown.
OPENOBSERVE_SPILL_PATH=var/obs-spill.jsonl

# OpenObserve alert delivery created by the provisioning script.
OPENOBSERVE_ALERT_TEMPLATE=xflickr_telegram_v1
OPENOBSERVE_ALERT_DESTINATION=xflickr_telegram
# Source destination copied once when xflickr_telegram does not exist yet.
OPENOBSERVE_ALERT_SOURCE_DESTINATION=javmeta_telegram

# Stable identity for this example instance; use a unique value per node.
NODE_ID=xflickr-jooxf68
# Required versioned master keys, formatted as id:base64 entries separated by commas.
# Keep the key material in the process environment or a secret manager.
XFLICKR_MASTER_KEYS=
# ID of the key used for new encrypted values; older IDs remain available for decrypting.
XFLICKR_MASTER_KEY_ACTIVE=

# Argon2id password hashing cost. Memory is in KiB; use consistent values
# across application instances so login verification cost remains uniform.
ARGON2ID_MEMORY=65536
# Argon2id time cost (number of iterations).
ARGON2ID_ITERATIONS=3
# Argon2id parallelism (number of lanes/threads).
ARGON2ID_PARALLELISM=2
# Random salt size in bytes.
ARGON2ID_SALT_LENGTH=16
# Derived password hash size in bytes.
ARGON2ID_KEY_LENGTH=32

# Where Flickr sends the browser after the member approves access. Must be reachable by the browser and match the XFlickr API address.
FLICKR_OAUTH_CALLBACK_URL=http://127.0.0.1:8080/flickr-accounts/callback
# Optional Flickr-compatible server (fakeflickr) for REST and OAuth calls; empty uses Flickr. Used by make e2e.
FLICKR_UPSTREAM_URL=

# Default HTTP listener port.
HTTP_PORT=8080
# Container and process liveness/readiness probe listener.
OBS_HTTP_PORT=8081
# Default application log level.
LOG_LEVEL=info
