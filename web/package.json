{
  "name": "xflickr-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "node scripts/check-i18n.mjs && eslint . && prettier --check .",
    "test:i18n-script": "node --test scripts/check-i18n.test.mjs",
    "format": "prettier --write .",
    "gen:api": "redocly bundle ../contracts/openapi/openapi.yaml --output ../.tmp/openapi.bundle.yaml && orval --config orval.config.ts && prettier --write src/shared/api/gen src/shared/api/zod",
    "test": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:mocked": "playwright test --config playwright.mocked.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "i18next": "26.5.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-router": "8.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.71.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.3.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "orval": "8.47.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@scalar/json-magic@0.16.1": {
      "undici": "7.30.2"
    },
    "undici": "8.12.4"
  }
}
